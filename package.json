{
  "name": "dsh-kuakua",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "一键夸夸：DSH 输入栏里的夸夸按钮 + 表情包面板（置顶、删除、从 QQ 导入、把对话里的图收进来）。",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "sticker",
    "praise",
    "表情包"
  ],
  "author": "biu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/biu-caq/dsh-kuakua.git"
  },
  "homepage": "https://github.com/biu-caq/dsh-kuakua#readme",
  "bugs": {
    "url": "https://github.com/biu-caq/dsh-kuakua/issues"
  }
}
